# Switch to Schlaubox by setting LLM_BACKEND=schlaubox.
LLM_BACKEND=schlaubox

# comma seperated list of ollama servers
OLLAMA_URLS=http://127.0.0.1:11434
LLM_MODEL_OLLAMA=gemma3:4b

SCHLAUBOX_URL=http://intern.schlaubox.de:11434
LLM_MODEL_SCHLAUBOX=llama3.3:70b
SCHLAUBOX_TIMEOUT=500

# optional provider agnostic model override.
# LLM_MODEL=llama3.3:70b