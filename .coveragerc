# What is measured is the code we write and CI can actually run.
#
# _betteringest/ is vendored upstream code, adapted but not ours to test: ~960
# statements at ~24% that say nothing about what we write.
#
# betteringest_pdf.py and _captioning.py are ours, but they are the OCR path —
# they need paddlepaddle + paddlex (requirements-ocr.txt, ~1GB), which CI does
# not install and should not. Their deterministic half, the massager, IS tested
# (modules/ingest/_massage.py is at 96% via tests/test_betteringest_ingest.py);
# what is excluded here is the orchestration that cannot run without the engine.
#
# Nothing else is excluded. ollama_pool.py spawns subprocesses and is awkward,
# but it is where the unbounded-instances finding (H6) lives, so it is tested
# rather than hidden.
[run]
branch = True
omit =
    */_betteringest/*
    */modules/ingest/betteringest_pdf.py
    */modules/ingest/_captioning.py
    */tests/*
    */.venv/*
    */__pycache__/*

[report]
show_missing = True
skip_covered = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
